---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import EmbedPlayer from '../components/EmbedPlayer.astro';
import { url } from '../lib/url';
import blastdetector from '../assets/blastdetector.webp';
import afsky from '../assets/afsky.webp';
import condenada from '../assets/condenada.webp';
---

<Layout>
    <header class="w-full container mx-auto">
        <div class="flex flex-col items-center py-12">
            <a class="font-bold text-yellow-200 hover:text-yellow-50 text-5xl" href={url('index.html')}>
                &#123; &#125;
            </a>
            <p class="text-lg text-white mt-4">
                Between two worlds
            </p>
        </div>
    </header>

    <div class="flex flex-col px-4 items-center xl:w-3/4 sm:w-7/8 m-auto">
        <div class="bio w-full flex flex-col shadow px-4 mb-4">
            <div class="border bg-black flex flex-col justify-start p-6 text-white">
                <p>
                    Welcome to my corner of the web!
                </p>
                <p class="mt-3">
                    I'm Lino, a programmer & drummer from Manta -
                    <a class="text-yellow-200 hover:text-purple-400 hover:underline"
                        href="https://youtu.be/j9c5Fqbidvs?si=irZO4UeA2pqRdoq6" target="_blank"
                        title="Julio Jaramillo, the essence of what it means to be ecuadorian.">
                        Ecuador</a>, currently based in The Netherlands.
                </p>
            </div>
        </div>

        <div
            class="projects w-full grid xl:grid-cols-3 xl:gap-8 lg:grid-cols-2 lg:gap-8 md:grid-cols-2 md:gap-8 sm:grid-cols-1 sm:gap-2 px-4 mb-5">
            <div class="flex flex-col shadow my-4 h-fit border">
                <Image class="min-w-full" src={blastdetector} alt="The Blast-Beat Detector" />
                <div class=" bg-black flex flex-col justify-start p-6">
                    <a href={url('code.html')} class="text-blue-200 text-sm font-bold uppercase pb-4 hover:underline">Dev
                        projects</a>
                    <a href="https://github.com/MutilatedPeripherals/blastbeat-detector"
                        class="text-white text-3xl font-bold hover:text-purple-400 hover:underline pb-4">The Blast-Beat
                        Detector</a>
                    <p class="text-white text-sm pb-3">
                        Released in November 2025
                    </p>
                    <div class="text-white pb-6">
                        <p class="mb-3">Experimental package for identifying blast-beats in songs using spectral
                            analysis.</p>
                    </div>
                    <a href="https://mutilatedperipherals.github.io/blastbeat-detector/" target="_blank"
                        class="w-fit uppercase text-yellow-200 hover:text-purple-400 hover:underline">Try
                        it out
                    </a>
                </div>
            </div>

            <div class="flex flex-col shadow my-4  h-fit border">
                <EmbedPlayer id="afsky" kind="bandcamp" cover={afsky}
                    src="https://bandcamp.com/EmbeddedPlayer/album=449030136/size=large/bgcol=333333/linkcol=ffffff/minimal=true/track=614358010/transparent=true/"
                    fallback={{ href: 'https://afsky.bandcamp.com/album/f-llesskab', text: 'Fællesskab by AFSKY' }} />

                <div class=" bg-black flex flex-col justify-start p-6">
                    <a href={url('music.html')}
                        class="text-blue-200 text-sm font-bold uppercase pb-4 hover:underline">Recommended
                        albums</a>
                    <a href="https://afsky.bandcamp.com/album/f-llesskab"
                        class="text-white text-3xl font-bold hover:text-purple-400 hover:underline pb-4"
                        target="_blank">
                        Fællesskab
                        by Afsky</a>
                    <p class="text-white text-sm pb-3">
                        Released in October 2025
                    </p>
                    <div class="text-white pb-6">
                        <p class="mb-3">Probably my favorite black metal band right now.</p>
                    </div>
                    <a href="https://afsky.bandcamp.com/album/f-llesskab" target="_blank"
                        class="uppercase text-yellow-200 hover:text-yellow-50 hover:underline">Listen on Bandcamp
                    </a>
                </div>
            </div>


            <div class="flex flex-col shadow my-4  h-fit border">
                <EmbedPlayer id="condenada" kind="bandcamp" cover={condenada}
                    src="https://bandcamp.com/EmbeddedPlayer/track=378931174/size=large/bgcol=333333/linkcol=ffffff/minimal=true/transparent=true/"
                    fallback={{ href: 'https://masakrador593.bandcamp.com/track/condenada-single', text: 'Condenada by Masakrador' }} />
                <div class=" bg-black flex flex-col justify-start p-6">
                    <a href={url('music.html')} class="text-blue-200 text-sm font-bold uppercase pb-4 hover:underline">Music
                        Projects</a>
                    <a href="https://masakrador593.bandcamp.com/"
                        class="text-white text-3xl font-bold hover:text-purple-400 hover:underline pb-4"
                        target="_blank">
                        Masakrador - Condenada</a>
                    <p class="text-white text-sm pb-3">
                        Recorded DIY in Manta, early 2020
                    </p>
                    <div class="text-white pb-6">
                        <p class="mb-3">First single from the grindcore duo formed with my cousin
                            Jorge.</p>
                    </div>
                    <a href="https://masakrador593.bandcamp.com/" target="_blank"
                        class="uppercase text-yellow-200 hover:text-yellow-50 hover:underline">Listen on Bandcamp
                    </a>
                </div>
            </div>
        </div>
    </div>
</Layout>
