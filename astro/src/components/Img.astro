---
// Astro's <Image>, plus the spinning spiral (.loading-spiral in input.css) behind it until the image has loaded,
// then a short crossfade into the picture (spiralFade in Layout.astro).
// The spiral is the image's own background, so it adds nothing to the layout.
import { Image } from 'astro:assets';
import type { ComponentProps } from 'astro/types';

type Props = ComponentProps<typeof Image>;

const { class: className, ...props } = Astro.props;
---

<Image {...props as Props} class:list={[className, 'loading-spiral']} onload="spiralFade(this)" />
